rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to check if a username exists
    match /usernames/{username} {
      allow read: if true;
      allow write: if true;  // For development, we'll allow write. In production, this should be more restricted
    }
    
    // Allow users to access their own data
    match /users/{username}/{document=**} {
      allow read, write: if true;  // For development. In production, this should check if request.auth.token.username == username
    }
    
    // Deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 